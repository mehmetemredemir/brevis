<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://android.com"> 
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
    tools:ignore="ProtectedPermissions" />

<!-- Android 13+ için bildirim gönderme izni (AI özet bildirimini biz de atacağız) -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- Foreground Service çalıştırmak için -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

<!--
    Android 14+ (API 34) zorunlu FGS type deklarasyonu.
    NotificationListenerService standart bir FGS type'a girmediği için
    "specialUse" kullanıp gerekçe belirtiyoruz. Google Play Console'da da
    aynı gerekçeyi (Bildirim özetleme / notification summarization) beyan
    etmeniz gerekecek.
-->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

<!-- Cihaz uyurken zamanlayıcının (cooldown) doğru tetiklenmesi için (opsiyonel, agresif OEM'lerde önerilir) -->
<uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="brevis"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />


<service
    android:name=".notification.BrevisNotificationListenerService"
    android:exported="false"
    android:label="Brevis Bildirim Dinleyici"
    android:foregroundServiceType="specialUse"
    android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">

    <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
    </intent-filter>

    <!--
        default_filter_types: Sistemin bize göndereceği bildirim türlerini daraltıyoruz.
        "conversations" WhatsApp gibi mesajlaşma bildirimlerini kapsar; gereksiz
        sistem bildirimlerini (şarj, wifi vb.) baştan elemek CPU'yu boşuna yormaz.
    -->
    <meta-data
        android:name="android.service.notification.default_filter_types"
        android:value="conversations|alerting" />

    <!--
        specialUse foreground service için Android 14'te zorunlu gerekçe alanı.
        Play Console beyanınızla birebir aynı metni kullanın.
    -->
    <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="notification-summarization-for-wearables" />

</service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
